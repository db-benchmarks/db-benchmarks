#!/usr/bin/env bash

echo -en "\tStarting loading at "
date

proc=$(cat data/manticoresearch_shards/.shards)
docker exec -e proc=$proc -e test=$test manticoresearch_engine bash -c \
'for n in `seq 1 $proc`; do (indexer --noprogress -c /etc/manticoresearch/manticore.conf $test$n | tee /tmp/$test$n) & pids[${n}]=$!; done; for pid in ${pids[*]}; do wait $pid; done'
