#!/usr/bin/env bash
set -euo pipefail

path=$(pwd)
fluent_bit_dir="$path/fluent-bit"
if [[ ! -f "$fluent_bit_dir/fluent-bit.conf" ]]; then
  fluent_bit_dir="$path/elasticsearch/fluent-bit$suffix"
fi
if [[ ! -f "$fluent_bit_dir/fluent-bit.conf" ]]; then
  fluent_bit_dir="$path/elasticsearch/fluent-bit"
fi

template_dir="$path/elasticsearch/fluent-bit$suffix"
if [[ ! -f "$template_dir/template.json" ]]; then
  template_dir="$path/elasticsearch/fluent-bit"
fi

normalize_function=""
id_key=""
if [[ "$test" == "taxi" ]]; then
  normalize_function="parse_taxi"
  id_key="trip_id"
fi

../misc/fluent-bit/run.sh elasticsearch 9200 "$fluent_bit_dir" "$template_dir" "$normalize_function" "$id_key"
