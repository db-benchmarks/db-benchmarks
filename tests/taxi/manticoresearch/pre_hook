#!/usr/bin/env bash

echo -e "Manticore Search (type $suffix):"
index_suffix="${suffix}${MANTICORE_CUSTOM_IMAGE_SUFFIX:-}"

docker compose -f ../../docker-compose.yml --env-file ../../.env stop manticoresearch
docker compose -f ../../docker-compose.yml --env-file ../../.env rm -f manticoresearch

if [ -z "$MANTICORE_REPORTED_VERSION" ]; then
  echo "" > manticoresearch/manticore$index_suffix.conf
  MANTICORE_REPORTED_VERSION=$(
    suffix="$suffix" docker compose -f ../../docker-compose.yml --env-file ../../.env \
      run --rm --no-deps manticoresearch searchd --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1
  )
  export MANTICORE_REPORTED_VERSION
fi
echo "Manticore version: $MANTICORE_REPORTED_VERSION"

shards=$(../misc/manticore_shards_from_cpuset.sh ../../.env)
if [ -z "$shards" ]; then
  echo -e "\tCouldn't determine shard count from cpuset"
  exit 1
fi
echo -e "\tManticore shards from cpuset: $shards"

php manticoresearch/generate_manticore_config.php --test="$test" --type="$suffix" --shards="$shards" > manticoresearch/manticore$index_suffix.conf

if [ -f manticoresearch/idx$index_suffix/${test}1.*sph ]; then
  echo -e "${COLORED}\tNo need to rebuild${NC}"
  exit 10
fi

# Source local hook if it exists
if [ -f ../../local_hooks/taxi_hook.sh ]; then
  source ../../local_hooks/taxi_hook.sh
fi

mkdir -p manticoresearch/idx$index_suffix/data/binlog
chmod 777 manticoresearch/idx$index_suffix/data/binlog
echo "$shards" > manticoresearch/idx$index_suffix/.shards
suffix=$suffix docker compose -f ../../docker-compose.yml --env-file ../../.env up -d manticoresearch

if timeout 120 grep -qm1 '\[BUDDY\] started' <(docker logs -f manticoresearch_engine); then
  echo -e '\tAccepting connections';
else
  echo -e '\tManticore failed to start properly in 60 seconds';
  exit 1
fi
