#!/usr/bin/env bash

workers=$(nproc)
path=$(pwd)
# We use here docker compose cause it usually has higher version (we need it for JSON formatting)
network_name=$(docker compose -f ../../docker-compose.yml --env-file ../../.env config --format=json | jq .networks.default.name)

cmd="docker run -e PIPELINE_BATCH_SIZE=10000 \
         --env-file ../../.env \
         -e XPACK_MONITORING_ENABLED=false \
         -e PIPELINE_WORKERS=\"$workers\" \
         --network=\"$network_name\" --rm \
         -v $path/data/:/data/ \
         -v $path/elasticsearch/logstash$suffix/logstash.conf:/usr/share/logstash/pipeline/logstash.conf \
         -v $path/elasticsearch/logstash$suffix/template.json:/template.json \
         docker.elastic.co/logstash/logstash:9.4.3"

log=$(mktemp)
trap 'rm -f "$log"' EXIT
logstash_error_pattern='Encountered a retryable error|Request Entity Too Large|No Available connections|Marking url as dead|Elasticsearch Unreachable|Broken pipe|Failed to perform request|Attempted to send a bulk request|abort processing current batch|PHP Fatal error|Allowed memory size|unable to allocate memory|memory exhausted|out of memory|cannot allocate memory'

eval "$cmd" 2>&1 | tee "$log"
status=${PIPESTATUS[0]}

if [[ $status -ne 0 ]]; then
  if grep -q "ConcurrentModificationException" "$log"; then
    echo -e "\tLogstash exited with ConcurrentModificationException after pipeline shutdown; post_hook will verify inserted rows."
    exit 0
  fi

  exit "$status"
fi

if grep -qEi "$logstash_error_pattern" "$log"; then
  echo -e "\tLogstash reported output errors; failing ingestion before post_hook."
  grep -Ei "$logstash_error_pattern" "$log" | tail -20 >&2
  exit 1
fi