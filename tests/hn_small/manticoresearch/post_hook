#!/usr/bin/env bash

echo -en "\tFinished loading to table at "
date

inserted=$(docker exec manticoresearch_engine mysql -h0 -P9306 -N -B -e "SELECT count(*) FROM $test" | grep -Eo '[0-9]+' | tail -1)
echo -e "\tCount of inserted documents: $inserted"

if [[ ! $inserted -eq 1165439 ]]; then
  >&2 echo "Inserted count mismatch ($inserted / 1165439)"
  exit 98
fi
