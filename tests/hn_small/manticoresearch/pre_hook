#!/usr/bin/env bash

echo -e "Manticore Search (type $suffix):"
docker compose -f ../../docker-compose.yml --env-file ../../.env stop manticoresearch
docker compose -f ../../docker-compose.yml --env-file ../../.env rm -f manticoresearch

if [ -z "$MANTICORE_REPORTED_VERSION" ]; then
  echo "" > manticoresearch/manticore$suffix.conf
  MANTICORE_REPORTED_VERSION=$(
    docker compose -f ../../docker-compose.yml --env-file ../../.env \
      run --rm --no-deps manticoresearch searchd --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1
  )
  export MANTICORE_REPORTED_VERSION
fi
echo "Manticore version: $MANTICORE_REPORTED_VERSION"

php manticoresearch/generate_manticore_config.php --test=$test --type=$suffix > manticoresearch/manticore$suffix.conf

rt_dir="manticoresearch/idx$suffix/$test"
if [ -d "$rt_dir" ] && (
  [ -f "$rt_dir/$test.meta" ] ||
  [ -f "$rt_dir/$test.settings" ] ||
  ls -1 "$rt_dir/$test".*.sph >/dev/null 2>&1
); then
  echo -e "${COLORED}\tNo need to rebuild${NC}"
  exit 10
fi

mkdir -p manticoresearch/idx$suffix/data/binlog
chmod 777 manticoresearch/idx$suffix/data/binlog

compose_output=$(suffix=$suffix docker compose -f ../../docker-compose.yml --env-file ../../.env up -d manticoresearch 2>&1)
compose_status=$?
printf '%s\n' "$compose_output"
if [[ $compose_status -ne 0 ]]; then
  echo -e '\tManticore failed to start. Full docker compose output is shown above.'
  exit 1
fi

if timeout 120 grep -qm1 '\[BUDDY\] started' <(docker logs -f manticoresearch_engine); then
  echo -e '\tAccepting connections';
else
  echo -e '\tManticore failed to start properly in 60 seconds';
  exit 1
fi

if [ ! -f data/data.jsonl ]; then
  echo -e "\tConvert CSV to JSONL"
  php ./typesense/csv_jsonl.php ./data/data.csv ./data/data.jsonl
fi
