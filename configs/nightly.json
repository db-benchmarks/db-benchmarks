{
  "settings": {
    "image": "manticoresearch/manticore:%s",
    "quiet": true,
    "save": true,
    "result_engine": "manticoresearch",
    "success_hook": "local_hooks/nightly_hook.sh"
  },
  "init": {
    "taxi": [
      "manticoresearch:columnar_tuned"
    ],
    "hn_small": [
      "manticoresearch"
    ],
    "hn_small_vector": [
      "manticoresearch"
    ],
    "hn": [
      "manticoresearch:columnar_tuned",
      "manticoresearch:rowwise_tuned"
    ],
    "logs10m": [
      "manticoresearch:columnar",
      "manticoresearch:rowwise"
    ]
  },
  "tests": {
    "taxi": [
      {
        "engine": "manticoresearch:columnar_tuned",
        "memory": 110000
      }
    ],
    "hn_small": [
      {
        "engine": "manticoresearch",
        "memory": 110000
      },
      {
        "engine": "manticoresearch",
        "memory": 1024
      },
      {
        "engine": "manticoresearch",
        "memory": 1024,
        "limited": true
      }
    ],
    "hn_small_vector": [
      {
        "engine": "manticoresearch",
        "memory": 110000
      }
    ],
    "hn": [
      {
        "engine": "manticoresearch:columnar_tuned",
        "memory": 110000
      },
      {
        "engine": "manticoresearch:rowwise_tuned",
        "memory": 110000
      }
    ],
    "logs10m": [
      {
        "engine": "manticoresearch:columnar",
        "memory": 110000,
        "query_timeout": 600
      },
      {
        "engine": "manticoresearch:rowwise",
        "memory": 110000,
        "query_timeout": 600
      }
    ]
  }
}
